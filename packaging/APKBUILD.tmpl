# Maintainer: Henri Koski <henri.koski@bitbrewers.fi>
pkgname=hcibridge
pkgver=@PKGVER@
pkgrel=0
pkgdesc="Attach remote ESP32 Bluetooth bridges to the local Bluetooth stack"
url="https://github.com/heppu/hcibridge"
arch="x86_64 aarch64 armv7"
license="MIT"
depends="bluez bluez-openrc"
makedepends="zig"
install=""
subpackages="$pkgname-doc $pkgname-openrc $pkgname-bash-completion $pkgname-zsh-completion $pkgname-fish-completion"
source="$pkgname-$pkgver.tar.gz::https://github.com/heppu/hcibridge/archive/refs/tags/v$pkgver.tar.gz"
builddir="$srcdir/hcibridge-$pkgver"
sha512sums="@SHA512@  $pkgname-$pkgver.tar.gz"

build() {
	zig build -Doptimize=ReleaseSafe
	zig build gen
}

package() {
	install -Dm755 "$builddir"/zig-out/bin/hcibridge "$pkgdir"/usr/bin/hcibridge
	install -Dm644 "$builddir"/zig-out/gen/hcibridge.1 "$pkgdir"/usr/share/man/man1/hcibridge.1
	install -Dm644 "$builddir"/zig-out/gen/hcibridge.bash "$pkgdir"/usr/share/bash-completion/completions/hcibridge
	install -Dm644 "$builddir"/zig-out/gen/_hcibridge "$pkgdir"/usr/share/zsh/site-functions/_hcibridge
	install -Dm644 "$builddir"/zig-out/gen/hcibridge.fish "$pkgdir"/usr/share/fish/vendor_completions.d/hcibridge.fish
	install -Dm644 "$builddir"/host/config/config "$pkgdir"/etc/hcibridge/config
	install -Dm644 "$builddir"/host/config/config.d/50-example.conf "$pkgdir"/etc/hcibridge/config.d/50-example.conf
	install -Dm644 "$builddir"/host/modules-load.conf "$pkgdir"/usr/lib/modules-load.d/hci_vhci.conf
	install -Dm755 "$builddir"/host/openrc/hcibridged "$pkgdir"/etc/init.d/hcibridged
	install -Dm644 "$builddir"/host/openrc/hcibridged.confd "$pkgdir"/etc/conf.d/hcibridged
}
