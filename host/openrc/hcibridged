#!/sbin/openrc-run
# Attaches the remote ESP32 Bluetooth controller to the local bluez stack.

description="ESP32 HCI bridge client"
command="/usr/local/bin/hcibridged"
# Empty BRIDGE_HOST => discovery mode (find all bridges on the LAN).
command_args="${BRIDGE_HOST:+--host ${BRIDGE_HOST}} --vhci ${BRIDGE_VHCI:-/dev/vhci} ${BRIDGE_ARGS:-}"
supervisor="supervise-daemon"
respawn_delay=2
respawn_max=0
output_log="/var/log/hcibridged.log"
error_log="/var/log/hcibridged.log"

depend() {
    need net
    before bluetooth
}

start_pre() {
    modprobe hci_vhci || return 1
    checkpath --file --mode 0640 "$output_log"
}
